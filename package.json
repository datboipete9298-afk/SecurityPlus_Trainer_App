{
  "name": "securityplus-trainer-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "validate:data": "tsx scripts/validate-app-data.ts",
    "validate:data:mjs": "node scripts/validate-app-data.mjs",
    "validate:feedback": "tsx scripts/validate-feedback-data.ts",
    "validate:training": "tsx scripts/validate-training-system.ts",
    "validate:elite-labs": "tsx scripts/validate-elite-labs.ts",
    "validate:training:mjs": "node scripts/validate-training-system.mjs",
    "validate:videos": "node scripts/validate-videos.mjs",
    "validate:pdf-guides": "tsx scripts/validate-pdf-guides.ts",
    "validate:pdf-upload": "tsx scripts/validate-pdf-upload-system.ts",
    "validate:ai": "node scripts/validate-ai-system.mjs",
    "validate:ai-integration": "node scripts/validate-ai-integration.mjs",
    "validate:video-notes": "tsx scripts/validate-video-note-system.ts",
    "build": "npm run validate:data && npm run validate:feedback && npm run validate:training && npm run validate:elite-labs && npm run validate:videos && npm run validate:pdf-guides && npm run validate:pdf-upload && npm run validate:video-notes && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "openai": "^4.73.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.1.0",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "tsx": "^4.19.0",
    "vite": "^5.1.0"
  }
}
